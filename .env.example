# DashboardSales&Marketing — переменные окружения
# Скопируйте в .env для локальной разработки. На Railway задаются через Variables.

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production

# PostgreSQL (на Railway — внутренней ссылкой, одной строкой, без кавычек и переносов)
DATABASE_URL=postgresql://user:password@localhost:5432/dashboard_sm

# amoCRM
AMOCRM_SUBDOMAIN=your-subdomain
AMOCRM_TOKEN=your-long-lived-access-token

# Первичный администратор (создаётся командой `python scripts/migrate.py --create-admin`)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Нейросеть (кнопка «Рекомендации от нейросети») — ключ Claude API
ANTHROPIC_API_KEY=sk-ant-...
